/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:

    Not(in=a , out=nA );
    Not(in=b , out=nB );
    And(a=a, b=nB, out=anB );
    And(a=nA , b=b , out=nAb );
    Or(a=anB , b=nAb , out=out );

}