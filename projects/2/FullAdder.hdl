// by Nisan and Schocken, MIT Press.
/**
 * Computes the sum of three bits.
 */
CHIP FullAdder {
    IN a, b, c;  // 1-bit inputs
    OUT sum,     // Right bit of a + b + c
        carry;   // Left bit of a + b + c

    PARTS:
        Not(in=a , out=notA );
        Not(in=b , out=notB );
        Not(in=c , out=notC );
        And(a=a , b=notB , out=tmp );
        And(a=tmp , b=notC , out=aNotBNotC );

        And(a=notA , b=b , out=tmp1 );
        And(a=tmp1 , b=notC , out=notABNotC ); 

        And(a=notA , b=notB , out=tmp2 );
        And(a=tmp2 , b=c , out=notANotBC );

        And(a=a , b=b , out=tmp3 );
        And(a=tmp3 , b=c , out=aBC );

        And(a=notA , b=b , out=tmp4 );
        And(a=tmp4 , b=c , out=notABC );

        And(a=a , b=notB , out=tmp5 );
        And(a=tmp5 , b=c , out=aNotBC );

        And(a=a , b=b , out=tmp6 );
        And(a=tmp6 , b=notC , out=aBNotC );

        And(a=a , b=b , out=tmp7 );
        And(a=tmp7 , b=c , out=aBC1 );

        Or(a=aNotBNotC , b=notABNotC , out=or1 );
        Or(a=notANotBC , b=aBC , out=or2 );
        Or(a=or1 , b=or2 , out=sum );

        Or(a=notABC , b=aNotBC , out=or3 );
        Or(a=aBNotC , b=aBC1 , out=or4 );
        Or(a=or3 , b=or4 , out=carry );

}