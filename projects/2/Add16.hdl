/**
 * 16-bit adder: Adds two 16-bit two's complement values.
 * The most significant carry bit is ignored.
 */
CHIP Add16 {
    IN a[16], b[16];
    OUT out[16];

    PARTS:
        HalfAdder(a=a[0] , b=b[0] , sum=out[0] , carry=c1 );


        HalfAdder(a=a[1] , b=b[1] , sum=out1 , carry=c20 );
        HalfAdder(a=out1 , b=c1 , sum=out[1] , carry=c21 );
        Xor(a=c20 , b=c21 , out=c2 );

        HalfAdder(a=a[2] , b=b[2] , sum=out2 , carry=c30 );
        HalfAdder(a=out2 , b=c2 , sum=out[2] , carry=c31 );
        Xor(a=c30 , b=c31 , out=c3 );

        HalfAdder(a=a[3] , b=b[3] , sum=out3 , carry=c40 );
        HalfAdder(a=out3 , b=c3 , sum=out[3] , carry=c41 );
        Xor(a=c40 , b=c41 , out=c4 );

        HalfAdder(a=a[4] , b=b[4] , sum=out4 , carry=c50 );
        HalfAdder(a=out4 , b=c4 , sum=out[4] , carry=c51 );
        Xor(a=c50 , b=c51 , out=c5 );

        HalfAdder(a=a[5] , b=b[5] , sum=out5 , carry=c60 );
        HalfAdder(a=out5 , b=c5 , sum=out[5] , carry=c61 );
        Xor(a=c60 , b=c61 , out=c6 );

        HalfAdder(a=a[6] , b=b[6] , sum=out6 , carry=c70 );
        HalfAdder(a=out6 , b=c6 , sum=out[6] , carry=c71 );
        Xor(a=c70 , b=c71 , out=c7 );

        HalfAdder(a=a[7] , b=b[7] , sum=out7 , carry=c80 );
        HalfAdder(a=out7 , b=c7 , sum=out[7] , carry=c81 );
        Xor(a=c80 , b=c81 , out=c8 );

        HalfAdder(a=a[8] , b=b[8] , sum=out8 , carry=c90 );
        HalfAdder(a=out8 , b=c8 , sum=out[8] , carry=c91 );
        Xor(a=c90 , b=c91 , out=c9 );

        HalfAdder(a=a[9] , b=b[9] , sum=out9 , carry=c100 );
        HalfAdder(a=out9 , b=c9 , sum=out[9] , carry=c101 );
        Xor(a=c100 , b=c101 , out=c10 );

        HalfAdder(a=a[10] , b=b[10] , sum=out10 , carry=c110 );
        HalfAdder(a=out10 , b=c10 , sum=out[10] , carry=c111 );
        Xor(a=c110 , b=c111 , out=c11 );

        HalfAdder(a=a[11] , b=b[11] , sum=out11 , carry=c120 );
        HalfAdder(a=out11 , b=c11 , sum=out[11] , carry=c121 );
        Xor(a=c120 , b=c121 , out=c12 );

        HalfAdder(a=a[12] , b=b[12] , sum=out12 , carry=c130 );
        HalfAdder(a=out12 , b=c12 , sum=out[12] , carry=c131 );
        Xor(a=c130 , b=c131 , out=c13 );

        HalfAdder(a=a[13] , b=b[13] , sum=out13 , carry=c140 );
        HalfAdder(a=out13 , b=c13 , sum=out[13] , carry=c141 );
        Xor(a=c140 , b=c141 , out=c14 );

        HalfAdder(a=a[14] , b=b[14] , sum=out14 , carry=c150 );
        HalfAdder(a=out14 , b=c14 , sum=out[14] , carry=c151 );
        Xor(a=c150 , b=c151 , out=c15 );

        HalfAdder(a=a[15] , b=b[15] , sum=out15 , carry=c160 );
        HalfAdder(a=out15 , b=c15 , sum=out[15] , carry=c161 );
        Xor(a=c160 , b=c161 , out=c16 );
       
}